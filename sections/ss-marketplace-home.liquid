{% assign featured_collection = section.settings.featured_collection | default: collections.all %}
{% assign whatsapp_store_message = 'Assalam o Alaikum, I want to order from Snatching Store: ' | append: shop.url %}

<section class="page-width market-shell">
  <aside class="category-panel" aria-label="Shop categories">
    <h2>Categories</h2>
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        <a class="category-link" href="{{ block.settings.link }}">{{ block.settings.label }}</a>
      {% endif %}
    {% else %}
      {% for collection in collections limit: 8 %}
        {% unless collection.handle == 'frontpage' %}
          <a class="category-link" href="{{ collection.url }}">{{ collection.title }}</a>
        {% endunless %}
      {% endfor %}
    {% endfor %}
  </aside>

  <div class="hero-panel hero-banner-frame" aria-label="Featured banner slider">
    <article class="hero-frame__slide hero-frame__slide--1">
      {% if section.settings.main_banner_1 != blank %}
        {{ section.settings.main_banner_1 | image_url: width: 2400 | image_tag: class: 'hero-frame__image', loading: 'lazy', alt: section.settings.main_banner_1_alt }}
      {% else %}
        <div class="hero-frame__fallback"></div>
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.main_banner_1_link | default: section.settings.hero_link }}" aria-label="{{ section.settings.main_banner_1_alt | default: 'Featured promotion' }}"></a>
    </article>
    <article class="hero-frame__slide hero-frame__slide--2">
      {% if section.settings.main_banner_2 != blank %}
        {{ section.settings.main_banner_2 | image_url: width: 2400 | image_tag: class: 'hero-frame__image', loading: 'lazy', alt: section.settings.main_banner_2_alt }}
      {% else %}
        <div class="hero-frame__fallback"></div>
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.main_banner_2_link | default: section.settings.hero_link }}" aria-label="{{ section.settings.main_banner_2_alt | default: 'Featured promotion' }}"></a>
    </article>
    <article class="hero-frame__slide hero-frame__slide--3">
      {% if section.settings.main_banner_3 != blank %}
        {{ section.settings.main_banner_3 | image_url: width: 2400 | image_tag: class: 'hero-frame__image', loading: 'lazy', alt: section.settings.main_banner_3_alt }}
      {% else %}
        <div class="hero-frame__fallback"></div>
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.main_banner_3_link | default: section.settings.hero_link }}" aria-label="{{ section.settings.main_banner_3_alt | default: 'Featured promotion' }}"></a>
    </article>
    <div class="hero-frame__dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="hero-frame__content">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="hero-frame__actions">
        <a class="button button--dark" href="{{ section.settings.hero_link | default: routes.all_products_collection_url }}">Shop Bestsellers</a>
        <a class="button button--whatsapp" href="https://wa.me/923020220128?text={{ whatsapp_store_message | url_encode }}">Order on WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<section class="page-width ss-trust-strip" aria-label="Store benefits">
  <div>
    <strong>{{ section.settings.trust_1_title }}</strong>
    <span>{{ section.settings.trust_1_text }}</span>
  </div>
  <div>
    <strong>{{ section.settings.trust_2_title }}</strong>
    <span>{{ section.settings.trust_2_text }}</span>
  </div>
  <div>
    <strong>{{ section.settings.trust_3_title }}</strong>
    <span>{{ section.settings.trust_3_text }}</span>
  </div>
  <div>
    <strong>{{ section.settings.trust_4_title }}</strong>
    <span>{{ section.settings.trust_4_text }}</span>
  </div>
</section>

<section class="page-width ss-category-feature" aria-label="Featured categories">
  <a class="ss-category-card" href="{{ routes.collections_url }}/wall-hanging-decor">
    <span>Wall Hanging Decor</span>
    <strong>Handmade-style accents for empty walls</strong>
  </a>
  <a class="ss-category-card" href="{{ routes.collections_url }}/wall-hanging-decor">
    <span>Bottle & Jar Planters</span>
    <strong>Compact hanging jars and floral pieces</strong>
  </a>
  <a class="ss-category-card" href="{{ routes.collections_url }}/wall-hanging-decor">
    <span>Artificial Plants</span>
    <strong>Low-maintenance greenery for home corners</strong>
  </a>
</section>

<section class="page-width flash-sale-feature" aria-label="Decor highlights">
  <div class="flash-sale-feature__intro">
    <p class="eyebrow">Handcrafted picks</p>
    <h2>Featured Home Decor</h2>
    <p>Discover handcrafted wall decor designed to add colour, personality and charm to your space.</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">Shop decor</a>
  </div>
  <div class="flash-sale-feature__posters">
    <article class="flash-poster flash-poster--1">
      {% if section.settings.flash_poster_1 != blank %}
        {{ section.settings.flash_poster_1 | image_url: width: 2000 | image_tag: class: 'flash-poster__image', loading: 'lazy', alt: section.settings.flash_poster_1_alt }}
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.flash_poster_1_link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.flash_poster_1_alt | default: 'Flash sale poster' }}"></a>
    </article>
    <article class="flash-poster flash-poster--2">
      {% if section.settings.flash_poster_2 != blank %}
        {{ section.settings.flash_poster_2 | image_url: width: 2000 | image_tag: class: 'flash-poster__image', loading: 'lazy', alt: section.settings.flash_poster_2_alt }}
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.flash_poster_2_link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.flash_poster_2_alt | default: 'Flash sale poster' }}"></a>
    </article>
    <article class="flash-poster flash-poster--3">
      {% if section.settings.flash_poster_3 != blank %}
        {{ section.settings.flash_poster_3 | image_url: width: 2000 | image_tag: class: 'flash-poster__image', loading: 'lazy', alt: section.settings.flash_poster_3_alt }}
      {% endif %}
      <a class="hero-frame__link" href="{{ section.settings.flash_poster_3_link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.flash_poster_3_alt | default: 'Flash sale poster' }}"></a>
    </article>
    <div class="flash-sale-feature__dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>
</section>

<section class="page-width shelf">
  <div class="shelf__heading">
    <h2>{{ section.settings.featured_title }}</h2>
    <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}">See all</a>
  </div>
  <div class="product-grid">
    {% for product in featured_collection.products limit: 4 %}
      {% render 'product-card', product: product %}
    {% else %}
      {% for product in collections.all.products limit: 4 %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endfor %}
  </div>
</section>

<section class="page-width ss-process-section" aria-label="Handmade decor process">
  <div class="ss-section-copy">
    <p class="eyebrow">Made for home styling</p>
    <h2>Handcrafted details, simple wall styling</h2>
    <p>Choose a decor piece, confirm your order on Shopify or WhatsApp, and style your wall when it arrives. Product-specific size and care details appear on each product page when available.</p>
  </div>
  <div class="ss-process-grid">
    <div><strong>1. Pick your style</strong><span>Wall hangings, bottle planters or artificial floral decor.</span></div>
    <div><strong>2. Confirm payment</strong><span>Cash on Delivery is available for eligible orders across Pakistan.</span></div>
    <div><strong>3. Receive support</strong><span>Contact us quickly if your order arrives damaged or wrong.</span></div>
  </div>
</section>

<section class="page-width ss-style-ideas" aria-label="Decor ideas">
  <div class="shelf__heading">
    <div>
      <p class="eyebrow">Style your space</p>
      <h2>Decor ideas for every corner</h2>
    </div>
    <a href="{{ routes.all_products_collection_url }}">Shop decor</a>
  </div>
  <div class="ss-style-grid">
    <a class="ss-style-card" href="{{ routes.collections_url }}/wall-hanging-decor">
      <span>01</span>
      <strong>Living room wall</strong>
      <p>Create a warmer focal point with hanging jars, planters and floral accents.</p>
    </a>
    <a class="ss-style-card" href="{{ routes.collections_url }}/wall-hanging-decor">
      <span>02</span>
      <strong>Balcony corner</strong>
      <p>Add greenery and color without daily watering or heavy maintenance.</p>
    </a>
    <a class="ss-style-card" href="{{ routes.collections_url }}/wall-hanging-decor">
      <span>03</span>
      <strong>Gift-ready decor</strong>
      <p>Choose small handmade-style pieces for housewarmings and room makeovers.</p>
    </a>
  </div>
</section>

<section class="page-width ss-why-band" aria-label="Why shop at Snatching Store">
  <div class="ss-section-copy">
    <p class="eyebrow">Why Snatching Store?</p>
    <h2>Small details that make your space feel special</h2>
    <p>Affordable handcrafted wall decor, hanging planters and floral accents selected for homes across Pakistan.</p>
  </div>
  <div class="ss-benefit-grid">
    <div class="ss-benefit-item">
      <strong>Ready to Hang</strong>
      <span>Easy wall styling without complicated setup.</span>
    </div>
    <div class="ss-benefit-item">
      <strong>Artificial Greenery</strong>
      <span>Fresh decorative look with low maintenance.</span>
    </div>
    <div class="ss-benefit-item">
      <strong>Giftable Pieces</strong>
      <span>Thoughtful decor for birthdays and housewarmings.</span>
    </div>
    <div class="ss-benefit-item">
      <strong>Local Support</strong>
      <span>WhatsApp support for product and order questions.</span>
    </div>
  </div>
</section>

<section class="page-width ss-wall-set" aria-label="Complete wall set">
  <div class="ss-wall-set__copy">
    <p class="eyebrow">Curated wall look</p>
    <h2>Complete your wall with matching decor</h2>
    <p>Layer a statement planter with mini jars and floral accents to build a complete warm wall look.</p>
    <ul>
      <li>Mix compact, vertical and statement hanging pieces</li>
      <li>Works for living rooms, entrances and covered balconies</li>
      <li>Order on WhatsApp if you want help choosing a set</li>
    </ul>
    <a class="button button--dark" href="{{ routes.all_products_collection_url }}">Build your wall set</a>
  </div>
  <div class="ss-wall-set__products">
    {% for product in collections.all.products limit: 3 %}
      {% assign product_image = product.featured_media.preview_image | default: product.featured_image %}
      <a class="ss-mini-product" href="{{ product.url }}">
        {% if product_image %}
          {{ product_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: product.title }}
        {% endif %}
        <span>{{ product.title }}</span>
        <strong>{{ product.price | money }}</strong>
      </a>
    {% endfor %}
  </div>
</section>

<section class="page-width ss-reviews-section" aria-label="Customer reviews">
  <div class="ss-section-copy">
    <p class="eyebrow">Customer reviews</p>
    <h2>Real customer feedback will appear here</h2>
    <p>We only show genuine reviews. After your first verified reviews are collected, connect them here for stronger trust before scaling ads.</p>
  </div>
</section>

<section class="page-width ss-delivery-section" aria-label="Delivery and replacement information">
  <div>
    <strong>Delivery across Pakistan</strong>
    <p>{{ section.settings.trust_2_text }} Estimated delivery is {{ section.settings.delivery_estimate }} after confirmation.</p>
  </div>
  <div>
    <strong>Damage or wrong item support</strong>
    <p>If an item arrives broken, damaged or wrong, contact support with photos and your order number within the policy window.</p>
  </div>
</section>

<section class="page-width ss-faq-preview" aria-label="Frequently asked questions">
  <div class="shelf__heading">
    <div>
      <p class="eyebrow">Questions</p>
      <h2>Everything you need to know</h2>
    </div>
    <a href="/pages/faq">Full FAQ</a>
  </div>
  <div class="ss-faq-grid">
    <div>
      <strong>Is Cash on Delivery available?</strong>
      <p>Yes. Cash on Delivery is available on eligible orders across Pakistan.</p>
    </div>
    <div>
      <strong>How long is delivery?</strong>
      <p>Most orders are delivered within 2 to 4 days after confirmation.</p>
    </div>
    <div>
      <strong>Are these ready to hang?</strong>
      <p>Yes. Most decor pieces are designed for easy wall styling.</p>
    </div>
    <div>
      <strong>What if an item arrives damaged?</strong>
      <p>Contact us with your order number and photos within the policy window.</p>
    </div>
  </div>
</section>

<section class="page-width newsletter">
  <div>
    <h2>Get new wall decor drops first</h2>
    <p>Sign up for handcrafted decor arrivals, restocks and store updates.</p>
  </div>
  {% form 'customer' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="Email address" required>
    <button class="button" type="submit">Join</button>
  {% endform %}
</section>

