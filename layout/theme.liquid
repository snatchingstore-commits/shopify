<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#183378">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} - tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} - Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} - {{ shop.name }}{% endunless -%}
    </title>
    {% assign seo_description = page_description %}
    {% if request.page_type == 'index' %}
      {% assign seo_description = 'Affordable handcrafted wall decor, hanging planters, floral accents and glass jar decor delivered across Pakistan with Cash on Delivery available.' %}
    {% endif %}
    {% if seo_description %}
      <meta name="description" content="{{ seo_description | escape }}">
    {% endif %}
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'snatchingstore-brand.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'cart-ajax.js' | asset_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
